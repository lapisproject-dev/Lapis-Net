<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>%d{HH:mm:ss.SSS} %-5level %logger{20} - %msg%n</pattern></encoder>
  </appender>
  <logger name="net.lapisphilosophorum.lapisnet.onionwire" level="INFO"/>
  <logger name="net.lapisphilosophorum.lapisnet.onion" level="INFO"/>
  <logger name="net.lapisphilosophorum.lapisnet.dmonion" level="INFO"/>
  <root level="WARN"><appender-ref ref="STDOUT"/></root>
</configuration>
